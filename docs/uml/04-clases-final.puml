@startuml 04-clases-final
title Rumbo Sur - Diagrama de clases final (SOLID y GRASP)

skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam backgroundColor White
skinparam class {
  BackgroundColor White
  BorderColor #333333
  ArrowColor #333333
}
hide empty members
left to right direction

package "Enumeraciones" {
' ===================== ENUMERACIONES =====================

enum CategoriaTour {
  AVENTURA
  CULTURAL
  NATURALEZA
}

enum Temporada {
  BAJA
  MEDIA
  ALTA
}

enum NivelDificultad {
  BAJO
  MEDIO
  ALTO
}

enum EstadoSalida {
  PROGRAMADA
  CONFIRMADA
  COMPLETA
  EN_CURSO
  FINALIZADA
  CANCELADA
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  ANULADA
  FINALIZADA
}

enum TipoPasajero {
  ADULTO
  MENOR
  JUBILADO
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
}

enum TipoVehiculo {
  MICRO
  COMBI
  CAMIONETA
}

enum TipoServicio {
  EXCURSION
  TRASLADO
  SEGURO
}

enum TipoProveedor {
  HOTEL
  RESTAURANTE
  TRANSPORTISTA
}

}

package "Modelo del negocio" {
' ===================== PERSONAS =====================

abstract class Persona {
  # nombre: String
  # apellido: String
  # documento: String
  # telefono: String
  + obtenerNombreCompleto(): String
}

abstract class Empleado {
  # legajo: int
  + {abstract} getRol(): String
}

class Vendedor #FFF3CC {
  - comision: double
  + getRol(): String
}

class Guia #FFF3CC {
  - idiomas: List<String>
  - categoriasHabilitadas: List<CategoriaTour>
  - honorarioPorDia: double
  + getRol(): String
  + estaHabilitadoPara(cat: CategoriaTour): boolean
  + estaDisponible(inicio: LocalDate, fin: LocalDate): boolean
  + calcularHonorarios(salida: Salida): double
}

class Coordinador #FFF3CC {
  + getRol(): String
}

class Administrador #FFF3CC {
  + getRol(): String
}

class Cliente {
  - correo: String
  - paisResidencia: String
}

class Pasajero #FFF3CC {
  - fechaNacimiento: LocalDate
  - tipo: TipoPasajero
  - contactoEmergencia: String
  - restricciones: String
  + calcularEdad(fecha: LocalDate): int
  + tipoEsCompatible(fechaSalida: LocalDate): boolean
  + calcularPorcentajeTarifa(fechaSalida: LocalDate): double
  + agregarServicioAdicional(s: ServicioAdicional): void
  + getServiciosAdicionales(): List<ServicioAdicional>
  + totalServiciosAdicionales(): double
}

Persona <|-- Empleado
Persona <|-- Cliente
Persona <|-- Pasajero

Empleado <|-- Vendedor
Empleado <|-- Guia
Empleado <|-- Coordinador
Empleado <|-- Administrador

' ===================== CATALOGO =====================

abstract class Tour #FFF3CC {
  - codigo: String
  - nombre: String
  - descripcion: String
  - duracionDias: int
  - cupoMinimo: int
  - cupoMaximo: int
  + {abstract} getCategoria(): CategoriaTour
  + requiereSeguro(): boolean
  + puedeParticipar(datos: DatosPasajero, fecha: LocalDate): boolean
  + obtenerTarifa(fecha: LocalDate): Tarifa
  + obtenerServiciosObligatorios(): List<ServicioAdicional>
}

class TourAventura #FFF3CC {
  - nivelDificultad: NivelDificultad
  - edadMinima: int
  + getCategoria(): CategoriaTour
  + requiereSeguro(): boolean
  + puedeParticipar(datos: DatosPasajero, fecha: LocalDate): boolean
}

class TourCultural {
  + getCategoria(): CategoriaTour
}

class TourNaturaleza {
  + getCategoria(): CategoriaTour
}

class Actividad {
  - dia: int
  - orden: int
  - horario: LocalTime
  - descripcion: String
  - lugar: String
}

class Proveedor {
  - nombre: String
  - cuit: String
  - contacto: String
  - tipoServicio: TipoProveedor
}

class Tarifa {
  - temporada: Temporada
  - vigenciaDesde: LocalDate
  - vigenciaHasta: LocalDate
  - precioBase: double
  + estaVigente(fecha: LocalDate): boolean
}

class ServicioAdicional #FFF3CC {
  - nombre: String
  - precio: double
  - tipo: TipoServicio
  - obligatorio: boolean
}

Tour <|-- TourAventura
Tour <|-- TourCultural
Tour <|-- TourNaturaleza

Tour "1" *-- "1..*" Actividad : tiene itinerario >
Tour "1" *-- "0..*" Tarifa : tiene >
Tour "1" *-- "0..*" ServicioAdicional : ofrece >
Actividad "0..*" --> "0..1" Proveedor : incluye servicio de >

' ===================== OPERACION =====================

class Vehiculo {
  - patente: String
  - capacidad: int
  - tipo: TipoVehiculo
}

class Salida #FFF3CC {
  - id: long
  - fechaInicio: LocalDate
  - fechaFin: LocalDate
  - cupoMaximo: int
  - estado: EstadoSalida
  - listaEmitida: boolean
  + cuposOcupados(hoy: LocalDate): int
  + cuposDisponibles(hoy: LocalDate): int
  + verificarVencimientos(hoy: LocalDate): void
  + puedeParticipar(datos: DatosPasajero): boolean
  + obtenerTarifa(): Tarifa
  + diasHastaInicio(hoy: LocalDate): long
  + exigePagoTotal(hoy: LocalDate): boolean
  + totalServiciosAdicionales(): double
  + agregarReserva(reserva: Reserva): void
  + asignarGuia(guia: Guia): void
  + asignarVehiculo(vehiculo: Vehiculo): void
  + emitirLista(): List<Pasajero>
  + actualizarEstado(hoy: LocalDate): void
  + validarCondicionesInicio(): void
  + iniciar(): void
  + finalizar(): void
  + compareTo(otra: Salida): int
}

class Liquidacion {
  - fecha: LocalDate
  - dias: int
  - monto: double
}

Salida "0..*" --> "1" Tour : corresponde a >
Guia "0..1" -- "0..*" Salida : guia de >
Salida "0..*" --> "0..1" Vehiculo : usa >
Salida "1" -- "0..1" Liquidacion : genera >
Liquidacion "0..*" --> "1" Guia : paga a >

' ===================== VENTAS =====================

class Reserva #FFF3CC {
  - id: int
  - cliente: Cliente
  - salida: Salida
  - vendedor: Vendedor
  - pasajeros: List<Pasajero>
  - pagos: List<Pago>
  - notasAjuste: List<NotaAjuste>
  - fechaCreacion: LocalDateTime
  - estado: EstadoReserva
  - importeTotal: double
  - importeServiciosAdicionales: double
  - cancelacion: Cancelacion
  + agregarPasajero(datos: DatosPasajero, telefono: String): Pasajero
  + agregarPasajero(pasajero: Pasajero): void
  + incluirServiciosObligatorios(): void
  + agregarServicioAdicional(pasajero: Pasajero, servicio: ServicioAdicional): void
  + totalServiciosAdicionales(): double
  + registrarPago(pago: Pago): void
  + calcularTotalPagado(): double
  + calcularTotalCobrado(): double
  + calcularSaldoPendiente(): double
  + actualizarImporteTotal(importe: double): void
  + cambiarEstado(nuevoEstado: EstadoReserva): void
  + registrarCancelacion(cancelacion: Cancelacion): void
  + estaVencida(fechaSalida: LocalDate, hoy: LocalDate): boolean
  + anularSiVencida(fechaSalida: LocalDate, hoy: LocalDate): boolean
  + ocupaCupos(hoy: LocalDate): boolean
  + puedeCancelarse(): boolean
  + anularPorVencimiento(fechaSalida: LocalDate, hoy: LocalDate): void
  + reemplazarPasajero(documento: String, datos: DatosPasajero, hoy: LocalDate): void
  + registrarAjuste(motivo: String, importe: double, fecha: LocalDate): NotaAjuste
  + obtenerMedioPagoDevolucion(): MedioPago
}

class Pago #FFF3CC {
  - fecha: LocalDate
  - importe: double
  - recargo: double
  - medio: MedioPago
  - cuotas: int
}

class Cancelacion {
  - fecha: LocalDate
  - motivo: String
  - cancelacionAgencia: boolean
  - porcentajeDevolucion: double
  - importeDevuelto: double
  - medioDevolucion: MedioPago
}

class NotaAjuste {
  - fecha: LocalDate
  - motivo: String
  - importe: double
}

Reserva "0..*" --> "1" Cliente : titular >
Reserva "0..*" --> "1" Vendedor : atendida por >
Salida "1" -- "0..*" Reserva : recibe >
Reserva "1" *-- "1..*" Pasajero : incluye y crea mediante agregarPasajero >
Reserva "1" *-- "0..*" Pago : se abona con >
Reserva "1" *-- "0..*" NotaAjuste : corrige con y crea >
Reserva "1" -- "0..1" Cancelacion : puede tener >
Pasajero "0..*" -- "0..*" ServicioAdicional : contrata >

}

package "Raiz y persistencia" {
' ===================== RAIZ DEL SISTEMA Y PERSISTENCIA =====================

class Agencia #DDEEFF {
  - tours: List<Tour>
  - salidas: List<Salida>
  - clientes: List<Cliente>
  - reservas: List<Reserva>
  - empleados: List<Empleado>
  - vehiculos: List<Vehiculo>
  - proveedores: List<Proveedor>
  + buscarTour(codigo: String): Tour
  + buscarSalida(id: long): Salida
  + buscarCliente(documento: String): Cliente
  + buscarReserva(numero: long): Reserva
  + buscarEmpleado(legajo: int): Empleado
  + buscarVehiculo(patente: String): Vehiculo
  + siguienteNumeroReserva(): long
  + agregarReserva(reserva: Reserva): void
}

interface RepositorioAgencia #DDEEFF {
  + guardar(agencia: Agencia): void
  + cargar(): Agencia
}

class RepositorioAgenciaArchivo #DDEEFF {
  - rutaArchivo: String
  + guardar(agencia: Agencia): void
  + cargar(): Agencia
}


note right of Agencia
  Agencia es la raiz del sistema: agrupa
  las colecciones de Tour, Salida, Reserva,
  Cliente, Empleado, Vehiculo y Proveedor.
end note

Agencia o-- "0..*" Tour
Agencia o-- "0..*" Salida
Agencia o-- "0..*" Reserva
Agencia o-- "0..*" Cliente
Agencia o-- "0..*" Empleado
Agencia o-- "0..*" Vehiculo
Agencia o-- "0..*" Proveedor

RepositorioAgencia <|.. RepositorioAgenciaArchivo
RepositorioAgencia ..> Agencia : persiste >

}

package "Control e interfaz" {
' ===================== CONTROL E INTERFAZ =====================

class DatosPasajero #DDEEFF {
  - nombre: String
  - apellido: String
  - documento: String
  - fechaNacimiento: LocalDate
  - tipo: TipoPasajero
  - contactoEmergencia: String
  - restricciones: String
}

class MenuConsola #DDEEFF {
  + mostrarMenu(): void
}

class ControladorReservas #DDEEFF {
  + ControladorReservas(agencia: Agencia, repo: RepositorioAgencia)
  + ControladorReservas(agencia: Agencia, repo: RepositorioAgencia, calculadora: CalculadoraPrecioReserva)
  + registrarReserva(reserva: Reserva): void
  + calcularPrecio(idReserva: int): double
  + registrarPago(idReserva: int, idPago: int, importe: double, medio: MedioPago, cuotas: int): Pago
  + consultarSaldo(idReserva: int): double
  + confirmarReserva(idReserva: int): void
  + confirmarReserva(idReserva: int, hoy: LocalDate): void
  + cancelarReserva(idReserva: int, motivo: String, porAgencia: boolean): Cancelacion
  + calcularCancelacion(idReserva: int, motivo: String, fechaSalida: LocalDate, porAgencia: boolean): Cancelacion
  + agregarServicioAdicional(idReserva: int, documento: String, s: ServicioAdicional): void
  + reemplazarPasajero(idReserva: int, documento: String, datos: DatosPasajero, hoy: LocalDate): void
  + registrarAjuste(idReserva: int, motivo: String, importe: double, fecha: LocalDate): NotaAjuste
  - actualizarVigenciaReserva(idReserva: int, hoy: LocalDate): Reserva
}

class ControladorOperaciones #DDEEFF {
  + registrarTour(tour: Tour): void
  + registrarTarifa(codigoTour: String, tarifa: Tarifa): void
  + registrarProveedor(proveedor: Proveedor): void
  + registrarGuia(guia: Guia): void
  + registrarVehiculo(vehiculo: Vehiculo): void
  + programarSalida(codigoTour: String, inicio: LocalDate, fin: LocalDate, cupo: int): Salida
  + actualizarEstadoSalida(idSalida: long, hoy: LocalDate): void
  + asignarRecursos(idSalida: long, legajoGuia: int, patente: String): void
  + emitirListaPasajeros(idSalida: long): List<Pasajero>
  + emitirListaPasajeros(idSalida: long, hoy: LocalDate): List<Pasajero>
  + iniciarSalida(idSalida: long): void
  + iniciarSalida(idSalida: long, hoy: LocalDate): void
  + finalizarSalida(idSalida: long): void
  + liquidarHonorarios(idSalida: long, hoy: LocalDate): Liquidacion
}

class GeneradorReportes #DDEEFF {
  + reporteOcupacionPorSalida(): String
  + reporteOcupacionPorSalida(hoy: LocalDate): String
  + reporteVentasPorVendedor(): String
  + reporteIngresosPorTour(): String
  + reporteCancelaciones(): String
}

}

package "Servicios de calculo, pagos y cancelaciones" {
' ===================== CALCULO DE PRECIOS =====================

class CalculadoraPrecioReserva #DDEEFF {
  - promociones: List<Promocion>
  + CalculadoraPrecioReserva()
  + CalculadoraPrecioReserva(promociones: List<Promocion>)
  + calcularSubtotalTour(reserva: Reserva, tarifaBase: double, fechaSalida: LocalDate): double
  + calcularMejorDescuento(reserva: Reserva, subtotalTour: double, fechaSalida: LocalDate): double
  + calcularTotal(reserva: Reserva, tarifaBase: double, fechaSalida: LocalDate, adicionales: double): double
}

interface Promocion #DDEEFF {
  + esAplicable(reserva: Reserva, fechaSalida: LocalDate): boolean
  + calcularDescuento(subtotalTour: double): double
}

class PromocionAnticipada #DDEEFF {
  + esAplicable(reserva: Reserva, fechaSalida: LocalDate): boolean
  + calcularDescuento(subtotalTour: double): double
}

class PromocionGrupo #DDEEFF {
  + esAplicable(reserva: Reserva, fechaSalida: LocalDate): boolean
  + calcularDescuento(subtotalTour: double): double
}

' ===================== PAGOS Y CANCELACIONES =====================

class GestorPagos #DDEEFF {
  + crearPago(id: int, importe: double, medio: MedioPago, cuotas: int): Pago
  + calcularSenaMinima(reserva: Reserva): double
  + cumpleSena(reserva: Reserva): boolean
  + consultarSaldo(reserva: Reserva): double
  + requierePagoTotal(fechaSalida: LocalDate): boolean
  + puedeConfirmarse(reserva: Reserva, fechaSalida: LocalDate): boolean
}

class GestorCancelaciones #DDEEFF {
  + calcularPorcentajeDevolucion(fecha: LocalDate, fechaSalida: LocalDate, porAgencia: boolean): double
  + crearCancelacion(reserva: Reserva, motivo: String, porAgencia: boolean, hoy: LocalDate): Cancelacion
  + cancelar(reserva: Reserva, motivo: String, porAgencia: boolean, hoy: LocalDate): Cancelacion
}

}

package "Excepciones" {
' ===================== EXCEPCIONES =====================

class ReglaNegocioException <<Exception>> #DDEEFF
class CuposInsuficientesException <<Exception>> #DDEEFF
class RequisitosNoCumplidosException <<Exception>> #DDEEFF
class PagoRequeridoException <<Exception>> #DDEEFF
class ReservaNoCancelableException <<Exception>> #DDEEFF
class OperacionNoPermitidaException <<Exception>> #DDEEFF
class EntidadNoEncontradaException <<Exception>> #DDEEFF

}

' ===================== RELACIONES SOLID Y GRASP =====================

Promocion <|.. PromocionAnticipada
Promocion <|.. PromocionGrupo
Comparable <|.. Salida

ReglaNegocioException <|-- CuposInsuficientesException
ReglaNegocioException <|-- RequisitosNoCumplidosException
ReglaNegocioException <|-- PagoRequeridoException
ReglaNegocioException <|-- ReservaNoCancelableException
ReglaNegocioException <|-- OperacionNoPermitidaException
ReglaNegocioException <|-- EntidadNoEncontradaException

MenuConsola --> ControladorReservas : delega >
MenuConsola --> ControladorOperaciones : delega >
MenuConsola --> GeneradorReportes : delega >

ControladorReservas --> Agencia : consulta >
ControladorReservas --> RepositorioAgencia : persiste mediante >
ControladorReservas --> CalculadoraPrecioReserva : usa >
ControladorReservas --> GestorPagos : usa >
ControladorReservas --> GestorCancelaciones : usa >
MenuConsola ..> Reserva : construye >

ControladorOperaciones --> Agencia : consulta >
ControladorOperaciones --> RepositorioAgencia : persiste mediante >
ControladorOperaciones --> GestorCancelaciones : usa >

GeneradorReportes --> Agencia : consulta >

CalculadoraPrecioReserva "1" o-- "1..*" Promocion : evalua >

GestorPagos ..> Pago : crea >
GestorCancelaciones ..> Cancelacion : crea >
ControladorOperaciones ..> Liquidacion : crea >

Reserva ..> DatosPasajero : recibe >

note right of Salida
  cuposOcupados cuenta los pasajeros de las reservas
  pendientes vigentes y confirmadas; las anuladas no
  ocupan lugares. Los menores de 3 anios tambien ocupan
  un lugar aunque no abonen tarifa.
  verificarVencimientos anula las reservas vencidas.
  emitirLista solo admite salidas CONFIRMADAS o COMPLETAS
  e incluye exclusivamente reservas CONFIRMADAS.
  iniciar solo admite salidas CONFIRMADAS o COMPLETAS.
  finalizar() pasa la salida a FINALIZADA y finaliza
  sus reservas vigentes.
end note

note right of Pago
  importe es el capital abonado (sin recargo) y se usa
  para saldo, sena y devolucion. recargo solo se informa
  con tarjeta en cuotas (7 %) y no cambia el total.
end note

legend right
  Azul: clase nueva por SOLID/GRASP
  Amarillo: clase modificada respecto del diagrama inicial
  Sin color: sin cambios
end legend

