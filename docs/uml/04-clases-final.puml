@startuml 04-clases-final
title Rumbo Sur - Diagrama de clases final (SOLID y GRASP)

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam backgroundColor White
skinparam class {
  BackgroundColor White
  BorderColor #333333
  ArrowColor #333333
}
hide empty members

' ===================== ENUMERACIONES =====================

enum CategoriaTour {
  AVENTURA
  CULTURAL
  NATURALEZA
}

enum Temporada {
  BAJA
  MEDIA
  ALTA
}

enum NivelDificultad {
  BAJO
  MEDIO
  ALTO
}

enum EstadoSalida {
  PROGRAMADA
  CONFIRMADA
  COMPLETA
  EN_CURSO
  FINALIZADA
  CANCELADA
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  ANULADA
  FINALIZADA
}

enum TipoPasajero {
  ADULTO
  MENOR
  JUBILADO
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
}

enum TipoVehiculo {
  MICRO
  COMBI
  CAMIONETA
}

enum TipoServicio {
  EXCURSION
  TRASLADO
  SEGURO
}

enum TipoProveedor {
  HOTEL
  RESTAURANTE
  TRANSPORTISTA
}

' ===================== PERSONAS =====================

abstract class Persona {
  # nombre: String
  # apellido: String
  # documento: String
  # telefono: String
  + obtenerNombreCompleto(): String
}

abstract class Empleado {
  # legajo: int
  + {abstract} getRol(): String
}

class Vendedor #FFF3CC {
  - comision: double
  + getRol(): String
}

class Guia #FFF3CC {
  - idiomas: List<String>
  - categoriasHabilitadas: List<CategoriaTour>
  - honorarioPorDia: double
  + getRol(): String
  + estaHabilitadoPara(cat: CategoriaTour): boolean
  + estaDisponible(inicio: LocalDate, fin: LocalDate): boolean
  + calcularHonorarios(salida: Salida): double
}

class Coordinador #FFF3CC {
  + getRol(): String
}

class Administrador #FFF3CC {
  + getRol(): String
}

class Cliente {
  - correo: String
  - paisResidencia: String
}

class Pasajero #FFF3CC {
  - fechaNacimiento: LocalDate
  - tipo: TipoPasajero
  - contactoEmergencia: String
  - restricciones: String
  + calcularEdad(fecha: LocalDate): int
  + obtenerFactorTarifa(fecha: LocalDate): double
}

Persona <|-- Empleado
Persona <|-- Cliente
Persona <|-- Pasajero

Empleado <|-- Vendedor
Empleado <|-- Guia
Empleado <|-- Coordinador
Empleado <|-- Administrador

' ===================== CATALOGO =====================

abstract class Tour #FFF3CC {
  - codigo: String
  - nombre: String
  - descripcion: String
  - duracionDias: int
  - cupoMinimo: int
  - cupoMaximo: int
  + {abstract} getCategoria(): CategoriaTour
  + requiereSeguro(): boolean
  + puedeParticipar(datos: DatosPasajero, fecha: LocalDate): boolean
  + obtenerTarifa(fecha: LocalDate): Tarifa
  + obtenerServiciosObligatorios(): List<ServicioAdicional>
}

class TourAventura #FFF3CC {
  - nivelDificultad: NivelDificultad
  - edadMinima: int
  + getCategoria(): CategoriaTour
  + requiereSeguro(): boolean
  + puedeParticipar(datos: DatosPasajero, fecha: LocalDate): boolean
}

class TourCultural {
  + getCategoria(): CategoriaTour
}

class TourNaturaleza {
  + getCategoria(): CategoriaTour
}

class Actividad {
  - dia: int
  - orden: int
  - horario: LocalTime
  - descripcion: String
  - lugar: String
}

class Proveedor {
  - nombre: String
  - cuit: String
  - contacto: String
  - tipoServicio: TipoProveedor
}

class Tarifa {
  - temporada: Temporada
  - vigenciaDesde: LocalDate
  - vigenciaHasta: LocalDate
  - precioBase: double
  + estaVigente(fecha: LocalDate): boolean
}

class ServicioAdicional #FFF3CC {
  - nombre: String
  - precio: double
  - tipo: TipoServicio
  - obligatorio: boolean
}

Tour <|-- TourAventura
Tour <|-- TourCultural
Tour <|-- TourNaturaleza

Tour "1" *-- "1..*" Actividad : tiene itinerario >
Tour "1" *-- "0..*" Tarifa : tiene >
Tour "1" *-- "0..*" ServicioAdicional : ofrece >
Actividad "0..*" --> "0..1" Proveedor : incluye servicio de >

' ===================== OPERACION =====================

class Vehiculo {
  - patente: String
  - capacidad: int
  - tipo: TipoVehiculo
}

class Salida #FFF3CC {
  - id: long
  - fechaInicio: LocalDate
  - fechaFin: LocalDate
  - cupoMaximo: int
  - estado: EstadoSalida
  - listaEmitida: boolean
  + cuposOcupados(ahora: LocalDateTime): int
  + cuposDisponibles(ahora: LocalDateTime): int
  + puedeParticipar(datos: DatosPasajero): boolean
  + obtenerTarifa(): Tarifa
  + diasHastaInicio(hoy: LocalDate): int
  + exigePagoTotal(hoy: LocalDate): boolean
  + totalServiciosAdicionales(): double
  + agregarReserva(reserva: Reserva): void
  + asignarGuia(guia: Guia): void
  + asignarVehiculo(vehiculo: Vehiculo): void
  + emitirLista(): List<Pasajero>
  + actualizarEstado(ahora: LocalDateTime): void
  + validarCondicionesInicio(): void
  + iniciar(): void
  + finalizar(): void
  + compareTo(otra: Salida): int
}

class Liquidacion {
  - fecha: LocalDate
  - dias: int
  - monto: double
}

Salida "0..*" --> "1" Tour : corresponde a >
Guia "0..1" -- "0..*" Salida : guia de >
Salida "0..*" --> "0..1" Vehiculo : usa >
Salida "1" -- "0..1" Liquidacion : genera >
Liquidacion "0..*" --> "1" Guia : paga a >

' ===================== VENTAS =====================

class Reserva #FFF3CC {
  - numero: long
  - fecha: LocalDate
  - estado: EstadoReserva
  - total: double
  - vencimientoPago: LocalDateTime
  + agregarPasajero(datos: DatosPasajero): Pasajero
  + incluirServiciosObligatorios(): void
  + agregarServicioAdicional(p: Pasajero, s: ServicioAdicional): void
  + totalServiciosAdicionales(): double
  + registrarTotal(total: double): void
  + iniciarRetencion(ahora: LocalDateTime): void
  + estaVencida(ahora: LocalDateTime): boolean
  + ocupaCupos(ahora: LocalDateTime): boolean
  + cantidadPasajeros(): int
  + registrarPago(pago: Pago): void
  + totalAbonado(): double
  + calcularSaldo(): double
  + seniaCubierta(): boolean
  + medioDePagoUsado(): MedioPago
  + puedeCancelarse(): boolean
  + confirmar(): void
  + anular(cancelacion: Cancelacion): void
  + anularPorVencimiento(): void
  + reemplazarPasajero(documento: String, datos: DatosPasajero, hoy: LocalDate): void
  + registrarAjuste(motivo: String, importe: double, fecha: LocalDate): NotaAjuste
}

class Pago #FFF3CC {
  - fecha: LocalDate
  - importe: double
  - recargo: double
  - medio: MedioPago
  - cuotas: int
}

class Cancelacion {
  - fecha: LocalDate
  - motivo: String
  - porcentajeDevolucion: int
  - importeDevuelto: double
  - medioDevolucion: MedioPago
}

class NotaAjuste {
  - fecha: LocalDate
  - motivo: String
  - importe: double
}

Reserva "0..*" --> "1" Cliente : titular >
Reserva "0..*" --> "1" Vendedor : atendida por >
Salida "1" -- "0..*" Reserva : recibe >
Reserva "1" *-- "1..*" Pasajero : incluye >
Reserva "1" *-- "0..*" Pago : se abona con >
Reserva "1" *-- "0..*" NotaAjuste : corrige con >
Reserva "1" -- "0..1" Cancelacion : puede tener >
Pasajero "0..*" -- "0..*" ServicioAdicional : contrata >

' ===================== RAIZ DEL SISTEMA Y PERSISTENCIA =====================

class Agencia #DDEEFF {
  - tours: List<Tour>
  - salidas: List<Salida>
  - clientes: List<Cliente>
  - reservas: List<Reserva>
  - empleados: List<Empleado>
  - vehiculos: List<Vehiculo>
  - proveedores: List<Proveedor>
  + buscarTour(codigo: String): Tour
  + buscarSalida(id: long): Salida
  + buscarCliente(documento: String): Cliente
  + buscarReserva(numero: long): Reserva
  + buscarEmpleado(legajo: int): Empleado
  + buscarVehiculo(patente: String): Vehiculo
  + siguienteNumeroReserva(): long
  + agregarReserva(reserva: Reserva): void
}

interface RepositorioAgencia #DDEEFF {
  + guardar(agencia: Agencia): void
  + cargar(): Agencia
}

class RepositorioAgenciaArchivo #DDEEFF {
  - rutaArchivo: String
  + guardar(agencia: Agencia): void
  + cargar(): Agencia
}

Agencia o-- "0..*" Tour
Agencia o-- "0..*" Salida
Agencia o-- "0..*" Reserva
Agencia o-- "0..*" Cliente
Agencia o-- "0..*" Empleado
Agencia o-- "0..*" Vehiculo
Agencia o-- "0..*" Proveedor

RepositorioAgencia <|.. RepositorioAgenciaArchivo
RepositorioAgencia ..> Agencia : persiste >

' ===================== CONTROL E INTERFAZ =====================

class DatosPasajero <<record>> #DDEEFF {
  nombre: String
  apellido: String
  documento: String
  fechaNacimiento: LocalDate
  tipo: TipoPasajero
  contactoEmergencia: String
  restricciones: String
}

class MenuConsola #DDEEFF {
  + mostrarMenu(): void
}

class ControladorReservas #DDEEFF {
  + registrarCliente(datos del cliente): Cliente
  + iniciarReserva(documentoCliente: String, idSalida: long, legajoVendedor: int, datos: List<DatosPasajero>, ahora: LocalDateTime): Reserva
  + agregarServicioAdicional(reserva: Reserva, p: Pasajero, s: ServicioAdicional): void
  + finalizarReserva(reserva: Reserva, medio: MedioPago, cuotas: int, ahora: LocalDateTime): Reserva
  + registrarPago(numero: long, importe: double, medio: MedioPago, cuotas: int, ahora: LocalDateTime): Pago
  + verificarVencimiento(reserva: Reserva, ahora: LocalDateTime): void
  + cancelarReserva(numero: long, motivo: String, porAgencia: boolean, ahora: LocalDateTime): Cancelacion
  + reemplazarPasajero(numero: long, documento: String, datos: DatosPasajero, ahora: LocalDateTime): void
  + registrarAjuste(numero: long, motivo: String, importe: double, ahora: LocalDateTime): NotaAjuste
}

class ControladorOperaciones #DDEEFF {
  + registrarTour / registrarTarifa / registrarProveedor
  + registrarGuia / registrarVehiculo
  + programarSalida(codigoTour: String, inicio: LocalDate, fin: LocalDate, cupo: int): Salida
  + actualizarEstadoSalida(idSalida: long, ahora: LocalDateTime): void
  + asignarRecursos(idSalida: long, legajoGuia: int, patente: String): void
  + emitirListaPasajeros(idSalida: long): List<Pasajero>
  + iniciarSalida(idSalida: long): void
  + finalizarSalida(idSalida: long): void
  + liquidarHonorarios(idSalida: long, hoy: LocalDate): Liquidacion
}

class GeneradorReportes #DDEEFF {
  + reporteOcupacionPorSalida(): String
  + reporteVentasPorVendedor(): String
  + reporteIngresosPorTour(): String
  + reporteCancelaciones(): String
}

' ===================== CALCULO DE PRECIOS =====================

class CalculadoraPrecioReserva #DDEEFF {
  + calcularTotal(reserva: Reserva): double
}

interface Promocion #DDEEFF {
  + calcularDescuento(reserva: Reserva, subtotalTour: double): double
}

class PromocionAnticipada #DDEEFF {
  + calcularDescuento(reserva: Reserva, subtotalTour: double): double
}

class PromocionGrupo #DDEEFF {
  + calcularDescuento(reserva: Reserva, subtotalTour: double): double
}

' ===================== PAGOS Y CANCELACIONES =====================

class GestorPagos #DDEEFF {
  + registrarPago(reserva: Reserva, importe: double, medio: MedioPago, cuotas: int, fecha: LocalDate): Pago
}

class GestorCancelaciones #DDEEFF {
  + cancelar(reserva: Reserva, motivo: String, porAgencia: boolean, ahora: LocalDateTime): Cancelacion
}

' ===================== EXCEPCIONES =====================

class ReglaNegocioException <<Exception>> #DDEEFF
class CuposInsuficientesException <<Exception>> #DDEEFF
class RequisitosNoCumplidosException <<Exception>> #DDEEFF
class PagoRequeridoException <<Exception>> #DDEEFF
class ReservaNoCancelableException <<Exception>> #DDEEFF
class OperacionNoPermitidaException <<Exception>> #DDEEFF
class EntidadNoEncontradaException <<Exception>> #DDEEFF

' ===================== RELACIONES SOLID Y GRASP =====================

Promocion <|.. PromocionAnticipada
Promocion <|.. PromocionGrupo
Comparable <|.. Salida

ReglaNegocioException <|-- CuposInsuficientesException
ReglaNegocioException <|-- RequisitosNoCumplidosException
ReglaNegocioException <|-- PagoRequeridoException
ReglaNegocioException <|-- ReservaNoCancelableException
ReglaNegocioException <|-- OperacionNoPermitidaException
ReglaNegocioException <|-- EntidadNoEncontradaException

MenuConsola --> ControladorReservas : delega >
MenuConsola --> ControladorOperaciones : delega >
MenuConsola --> GeneradorReportes : delega >

ControladorReservas --> Agencia : consulta >
ControladorReservas --> RepositorioAgencia : persiste mediante >
ControladorReservas --> CalculadoraPrecioReserva : usa >
ControladorReservas --> GestorPagos : usa >
ControladorReservas --> GestorCancelaciones : usa >
ControladorReservas ..> Reserva : crea >
ControladorReservas ..> ReglaNegocioException : lanza >

ControladorOperaciones --> Agencia : consulta >
ControladorOperaciones --> RepositorioAgencia : persiste mediante >
ControladorOperaciones --> GestorCancelaciones : usa >

GeneradorReportes --> Agencia : consulta >

CalculadoraPrecioReserva "1" --> "1..*" Promocion : evalua >

GestorCancelaciones ..> Cancelacion : crea >
GestorPagos ..> Pago : crea >

Reserva ..> DatosPasajero : recibe >
Reserva ..> Pasajero : crea >
Reserva ..> NotaAjuste : crea >

legend right
  Azul: clase nueva por SOLID/GRASP
  Amarillo: clase modificada respecto del diagrama inicial
  Sin color: sin cambios
end legend

@enduml
