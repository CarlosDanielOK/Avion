@startuml 02-secuencia-crear-reserva
title CU08 - Crear, calcular y confirmar reserva
autonumber

actor Vendedor
participant ":MenuConsola" as UI
participant ":ControladorReservas" as CTRL
participant ":Agencia" as AGE
participant ":Salida" as SAL
participant ":Reserva" as RES
participant ":CalculadoraPrecioReserva" as CALC
participant ":GestorPagos" as PAGOS
participant ":RepositorioAgencia" as REPO

Vendedor -> UI : cargar cliente, salida y pasajeros
UI -> CTRL : crearReserva(documento, salida, legajo, pasajeros)
CTRL -> AGE : buscarCliente / buscarSalida / buscarEmpleado
AGE --> CTRL : datos del negocio
CTRL -> SAL : cuposDisponibles(hoy)
alt cupos insuficientes
  SAL --> CTRL : 0
  CTRL --> UI : error de negocio
else cupos disponibles
  CTRL -> SAL : puedeParticipar(datos)
  SAL --> CTRL : cumple
  CTRL -> AGE : siguienteNumeroReserva()
  AGE --> CTRL : id
  create RES
  CTRL -> RES : new Reserva(id, cliente, salida, vendedor)
  loop cada pasajero
    CTRL -> RES : agregarPasajero(pasajero)
  end
  CTRL -> SAL : agregarReserva(reserva)
  CTRL -> AGE : agregarReserva(reserva)
  CTRL -> REPO : guardar(agencia)
  CTRL --> UI : reserva pendiente

  UI -> CTRL : calcularPrecio(id, tarifa, fecha, adicionales)
  CTRL -> CALC : calcularTotal(reserva, tarifa, fecha, adicionales)
  CALC --> CTRL : total
  CTRL -> RES : actualizarImporteTotal(total)
  CTRL -> REPO : guardar(agencia)

  UI -> CTRL : registrarPago(id, idPago, importe, medio, cuotas)
  CTRL -> PAGOS : crearPago(...)
  PAGOS --> CTRL : pago
  CTRL -> RES : registrarPago(pago)
  CTRL -> REPO : guardar(agencia)
  UI -> CTRL : confirmarReserva(id, fecha)
  CTRL -> RES : cambiarEstado(CONFIRMADA)
  CTRL -> REPO : guardar(agencia)
end
@enduml
