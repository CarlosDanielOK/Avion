@startuml 02-secuencia-crear-reserva
title CU08 - Crear reserva (flujo principal, falta de cupos y requisitos no cumplidos)
skinparam shadowing false
skinparam backgroundColor White
skinparam sequenceMessageAlign center
autonumber

actor Vendedor
participant ":MenuConsola" as UI
participant ":ControladorReservas" as CTRL
participant ":Salida" as SAL
participant ":Tour" as TOUR
participant ":Reserva" as RES
participant ":Pasajero" as PAS
participant ":CalculadoraPrecioReserva" as CALC
participant "p:Promocion" as PROMO
participant ":RepositorioReservas" as REPO

Vendedor -> UI : crearReserva(idCliente, idSalida, datosPasajeros)
UI -> CTRL : crearReserva(cliente, salida, vendedor, datosPasajeros)
activate CTRL
CTRL -> SAL : cuposDisponibles()
SAL --> CTRL : disponibles

alt disponibles < cantidad de pasajeros  [cupos insuficientes]
  CTRL --> UI : throw CuposInsuficientesException
  UI --> Vendedor : informa falta de disponibilidad
else hay cupos suficientes
  loop por cada datosPasajero
    CTRL -> SAL : puedeParticipar(datosPasajero)
    SAL -> TOUR : puedeParticipar(datosPasajero, fechaInicio)
    TOUR --> SAL : cumple
    SAL --> CTRL : cumple
    break pasajero no cumple los requisitos del tour
      CTRL --> UI : throw RequisitosNoCumplidosException
      UI --> Vendedor : informa que el pasajero no puede participar
    end
  end
  create RES
  CTRL -> RES : <<create>> new Reserva(cliente, salida, vendedor)
  loop por cada datosPasajero
    CTRL -> RES : agregarPasajero(datosPasajero)
    create PAS
    RES -> PAS : <<create>> new Pasajero(datosPasajero)
  end
  CTRL -> CALC : calcularTotal(reserva)
  activate CALC
  CALC -> SAL : obtenerTarifa()
  SAL --> CALC : tarifa
  loop por cada pasajero
    CALC -> PAS : obtenerFactorTarifa(fechaInicio)
    PAS --> CALC : factor
  end
  loop por cada promocion disponible
    CALC -> PROMO : calcularDescuento(reserva, subtotalTour)
    PROMO --> CALC : descuento
  end
  CALC -> CALC : aplicar el mayor descuento y sumar adicionales
  CALC --> CTRL : total
  deactivate CALC
  CTRL -> RES : definirTotal(total)
  CTRL -> REPO : guardar(reserva)
  CTRL --> UI : reserva (estado PENDIENTE)
  UI --> Vendedor : muestra importe y condiciones de pago
end
deactivate CTRL
@enduml
