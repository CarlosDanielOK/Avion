@startuml 02-secuencia-crear-reserva
title CU08 - Crear reserva (flujo principal y alternativas)

skinparam shadowing false
skinparam backgroundColor White
skinparam sequenceMessageAlign center
autonumber

actor Vendedor
participant ":MenuConsola" as UI
participant ":ControladorReservas" as CTRL
participant ":Agencia" as AGE
participant ":Salida" as SAL
participant ":Tour" as TOUR
participant ":Reserva" as RES
participant ":Pasajero" as PAS
participant ":CalculadoraPrecioReserva" as CALC
participant "p:Promocion" as PROMO
participant ":GestorPagos" as GP
participant ":RepositorioAgencia" as REPO

== Fase 1: iniciar la reserva (cupos, requisitos y pasajeros) ==

Vendedor -> UI : cargar cliente, salida y pasajeros
UI -> CTRL : iniciarReserva(documentoCliente, idSalida, legajoVendedor, datos, hoy)
activate CTRL

CTRL -> AGE : buscarCliente(documentoCliente)
AGE --> CTRL : cliente
CTRL -> AGE : buscarSalida(idSalida)
AGE --> CTRL : salida
CTRL -> AGE : buscarEmpleado(legajoVendedor)
AGE --> CTRL : vendedor

CTRL -> SAL : cuposDisponibles(hoy)
SAL --> CTRL : disponibles

alt disponibles < cantidad de pasajeros
  CTRL --> UI : CuposInsuficientesException
  UI --> Vendedor : informa falta de cupos
else cupos suficientes

  loop por cada DatosPasajero
    CTRL -> SAL : puedeParticipar(datosPasajero)
    SAL -> TOUR : puedeParticipar(datosPasajero, fechaInicio)
    TOUR --> SAL : cumple / no cumple
    SAL --> CTRL : cumple / no cumple
  end

  alt algun pasajero no cumple requisitos
    CTRL --> UI : RequisitosNoCumplidosException
    UI --> Vendedor : informa restricciones del tour
  else todos cumplen requisitos

    CTRL -> AGE : siguienteNumeroReserva()
    AGE --> CTRL : numero

    create RES
    CTRL -> RES : <<create>> new Reserva(numero, cliente, salida, vendedor, hoy)
    note right of RES
      La reserva nace en estado
      PENDIENTE y todavia no
      figura en la salida.
    end note

    loop por cada DatosPasajero
      RES -> RES : agregarPasajero(datosPasajero)
      create PAS
      RES -> PAS : <<create>> new Pasajero(datosPasajero)
      note right of PAS
        GRASP Creador: Reserva
        contiene a los pasajeros
        y los crea.
      end note
    end

    CTRL -> RES : incluirServiciosObligatorios()
    CTRL --> UI : reserva en preparacion

    opt el vendedor elige servicios opcionales (CU11)
      loop por cada servicio elegido
        UI -> CTRL : agregarServicioAdicional(reserva, pasajero, servicio)
        CTRL -> RES : agregarServicioAdicional(pasajero, servicio)
      end
    end

    == Fase 2: calcular el precio y registrar la reserva ==

    UI -> CTRL : finalizarReserva(reserva, medio, cuotas, hoy)

    CTRL -> CALC : calcularTotal(reserva)
    activate CALC
    CALC -> SAL : obtenerTarifa()
    SAL --> CALC : tarifa
    loop por cada pasajero
      CALC -> PAS : obtenerFactorTarifa(fechaInicio)
      PAS --> CALC : factor
    end
    loop por cada promocion disponible
      CALC -> PROMO : calcularDescuento(reserva, subtotalTour)
      PROMO --> CALC : descuento
    end
    note over CALC
      Se aplica solo la promocion
      de mayor descuento (RN17).
    end note
    CALC -> RES : totalServiciosAdicionales()
    RES --> CALC : adicionales
    CALC --> CTRL : total
    deactivate CALC

    CTRL -> RES : registrarTotal(total)

    CTRL -> SAL : exigePagoTotal(hoy)
    SAL --> CTRL : exige / no exige

    alt exige pago total y medio == null
      CTRL --> UI : PagoRequeridoException
      UI --> Vendedor : informa que debe abonar el total
      note right of CTRL
        La reserva no se agrega a la
        salida ni se guarda: se descarta.
      end note
    else se puede registrar la reserva

      alt exige pago total (faltan 10 dias o menos)
        CTRL -> GP : registrarPago(reserva, total, medio, cuotas, fecha)
        activate GP
        GP -> RES : registrarPago(pago)
        GP -> RES : seniaCubierta()
        RES --> GP : true
        GP -> RES : confirmar()
        GP --> CTRL : pago
        deactivate GP
      else faltan mas de 10 dias
        CTRL -> RES : iniciarRetencion(hoy)
        note right of RES
          vencimientoPago = el menor entre
          hoy + 2 dias y 10 dias antes
          de la salida (S04).
          Estado PENDIENTE: retiene cupos
          mientras no venza.
        end note
      end

      CTRL -> SAL : agregarReserva(reserva)
      CTRL -> AGE : agregarReserva(reserva)
      CTRL -> REPO : guardar(agencia)
      REPO --> CTRL : guardado
      CTRL --> UI : reserva CONFIRMADA o PENDIENTE
      UI --> Vendedor : muestra importe desglosado y estado
    end
  end
end

deactivate CTRL
@enduml
