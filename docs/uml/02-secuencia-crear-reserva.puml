@startuml 02-secuencia-crear-reserva
title CU08 / CU09 / CU12 / CU14 - Crear, calcular y confirmar una reserva

skinparam shadowing false
skinparam backgroundColor White
skinparam sequenceMessageAlign center
autonumber

actor Vendedor
participant ":MenuConsola" as UI
participant ":ControladorReservas" as CTRL
participant ":Reserva" as RES
participant ":Salida" as SAL
participant ":Agencia" as AGE
participant ":Tour" as TOUR
participant ":Pasajero" as PAS
participant ":CalculadoraPrecioReserva" as CALC
participant ":Promocion" as PROMO
participant ":GestorPagos" as GP
participant ":RepositorioAgencia" as REPO

== Registro de la reserva ==
Vendedor -> UI : crearReserva()
UI -> AGE : buscarCliente(documento)
AGE --> UI : cliente
UI -> AGE : buscarSalida(idSalida)
AGE --> UI : salida
UI -> AGE : buscarEmpleado(legajoVendedor)
AGE --> UI : vendedor
create RES
UI -> RES : <<create>> Reserva(id, cliente, salida, vendedor)
loop por cada pasajero informado
  Vendedor -> UI : ingresa datos del pasajero
  UI -> RES : agregarPasajero(datos, telefono)
  create PAS
  RES -> PAS : <<create>> Pasajero(datos, telefono)
  RES -> RES : validar y agregar pasajero
end
UI -> CTRL : registrarReserva(reserva)
activate CTRL
CTRL -> SAL : puedeParticipar(datos) / cuposDisponibles(hoy)
SAL --> CTRL : validación y cupos
alt salida no admite reservas, faltan cupos o pasajero no cumple requisitos
  CTRL --> UI : excepción de regla de negocio
  UI --> Vendedor : informa el motivo y no registra la reserva
else datos y cupos válidos
  CTRL -> RES : incluirServiciosObligatorios()
  RES -> TOUR : obtenerServiciosObligatorios()
  TOUR --> RES : servicios obligatorios
  CTRL -> SAL : agregarReserva(reserva)
  SAL -> SAL : verificarVencimientos(hoy) y actualizarEstado(hoy)
  CTRL -> AGE : agregarReserva(reserva)
  CTRL -> REPO : guardar(agencia)
  REPO --> CTRL : guardado
  CTRL --> UI : reserva registrada (PENDIENTE)
  UI --> Vendedor : informa número y estado de la reserva
end
deactivate CTRL

== Contratación opcional (si el vendedor elige un servicio) ==
opt servicio adicional opcional
  Vendedor -> UI : selecciona servicio y pasajero
  UI -> CTRL : agregarServicioAdicional(idReserva, documento, servicio)
  CTRL -> RES : agregarServicioAdicional(pasajero, servicio)
  RES -> PAS : agregarServicioAdicional(servicio)
  CTRL -> REPO : guardar(agencia)
  REPO --> CTRL : guardado
end

== Cálculo del precio ==
Vendedor -> UI : solicita calcular precio
UI -> CTRL : calcularPrecio(idReserva)
activate CTRL
CTRL -> AGE : buscarReserva(idReserva)
AGE --> CTRL : reserva
CTRL -> SAL : verificarVencimientos(hoy) / actualizarEstado(hoy)
SAL -> RES : estaVencida(fechaSalida, hoy)
RES --> SAL : estado vigente / ANULADA
SAL --> CTRL : estado de la salida actualizado
alt reserva vencida o salida cancelada
  CTRL --> UI : excepción; no se calcula el precio
  UI --> Vendedor : informa que la reserva ya no está vigente
else reserva vigente
  CTRL -> SAL : obtenerTarifa()
  SAL -> TOUR : obtenerTarifa(fechaInicio)
  TOUR --> SAL : tarifa vigente
  SAL --> CTRL : tarifa
  CTRL -> RES : totalServiciosAdicionales()
  RES --> CTRL : adicionales por pasajero
  CTRL -> CALC : calcularTotal(reserva, tarifaBase, fechaInicio, adicionales)
  activate CALC
  CALC -> RES : getPasajeros()
  RES --> CALC : pasajeros
  loop por cada pasajero
    CALC -> PAS : calcularPorcentajeTarifa(fechaInicio)
    PAS --> CALC : factor de tarifa
  end
  loop promociones configuradas
    CALC -> PROMO : esAplicable(reserva, fechaInicio)
    PROMO --> CALC : sí / no
    opt promoción aplicable
      CALC -> PROMO : calcularDescuento(subtotalTour)
      PROMO --> CALC : descuento
    end
  end
  CALC --> CTRL : total calculado
  deactivate CALC
  CTRL -> RES : actualizarServiciosAdicionales(adicionales)
  CTRL -> RES : actualizarImporteTotal(total)
  CTRL -> REPO : guardar(agencia)
  REPO --> CTRL : guardado
  CTRL --> UI : total de reserva
  UI --> Vendedor : muestra precio calculado
end
deactivate CTRL

== Registro de seña o pagos ==
Vendedor -> UI : ingresa importe, medio y cuotas
UI -> CTRL : registrarPago(idReserva, idPago, importe, medio, cuotas)
activate CTRL
CTRL -> SAL : verificarVencimientos(hoy) / actualizarEstado(hoy)
SAL --> CTRL : estado actualizado
alt reserva vencida o salida cancelada
  CTRL --> UI : excepción; no se registra el pago
  UI --> Vendedor : informa que la reserva ya no está vigente
else reserva vigente
  CTRL -> GP : crearPago(idPago, importe, medio, cuotas)
  GP -> GP : validar importe, medio y cuotas
  opt tarjeta en más de una cuota
    GP -> GP : aplicar recargo del 7 % al capital del pago
  end
  GP --> CTRL : pago
  CTRL -> RES : registrarPago(pago)
  RES -> RES : validar saldo e ID del pago
  CTRL -> REPO : guardar(agencia)
  REPO --> CTRL : guardado
  CTRL --> UI : pago registrado
  UI --> Vendedor : informa capital y recargo (si corresponde)
end
deactivate CTRL

== Confirmación de la reserva ==
Vendedor -> UI : confirmar reserva
UI -> CTRL : confirmarReserva(idReserva)
activate CTRL
CTRL -> SAL : verificarVencimientos(hoy) / actualizarEstado(hoy)
SAL --> CTRL : estado actualizado
alt reserva vencida o salida cancelada
  CTRL --> UI : informa que la reserva ya no está vigente
else reserva vigente
  CTRL -> GP : puedeConfirmarse(reserva, fechaSalida)
  GP -> RES : estaVencida(fechaSalida)
  RES --> GP : sí / no
  GP -> RES : calcularSaldoPendiente() / calcularTotalPagado()
  RES --> GP : saldo y capital abonado
  GP --> CTRL : puede / no puede confirmar
  alt no alcanza la seña del 30 % o, dentro de los últimos 10 días, no se pagó el total
    CTRL --> UI : informa que faltan condiciones de pago
  else condiciones de pago cumplidas
    CTRL -> RES : cambiarEstado(CONFIRMADA)
    CTRL -> REPO : guardar(agencia)
    REPO --> CTRL : guardado
    CTRL --> UI : reserva confirmada
  end
end
deactivate CTRL

note over UI,REPO
El precio, los pagos y la confirmación son opciones separadas del menú.
No se integra una pasarela de pagos: los pagos y devoluciones son simulaciones.
end note
@enduml
