
@startuml casos-uso-pagos
title Pagos y cancelaciones

skinparam shadowing false
skinparam backgroundColor White

skinparam usecase {
  BackgroundColor White
  BorderColor #333333
  ArrowColor #333333
}

skinparam actor {
  BackgroundColor White
  BorderColor #333333
}

left to right direction

actor "Vendedor" as VEN

rectangle "Sistema de Gestión Rumbo Sur" {
  usecase "CU12 - Registrar pagos" as CU12
  usecase "CU13 - Controlar saldos" as CU13
  usecase "CU14 - Confirmar o anular reservas" as CU14
  usecase "CU15 - Cancelar reserva" as CU15
  usecase "CU17 - Registrar ajustes económicos" as CU17
}

VEN --> CU12
VEN --> CU13
VEN --> CU14
VEN --> CU15
VEN --> CU17

CU12 .> CU13 : <<include>>

note right of CU14
  Confirmar cuando se cumplen
  las condiciones de pago.

  Anular cuando vence el plazo
  correspondiente sin que se
  complete el pago requerido.

  Las condiciones se detallan
  en las reglas de negocio.
end note

@enduml
