@startuml 03-secuencia-cancelar-reserva
title CU15 - Cancelar reserva
autonumber

actor Vendedor
participant ":MenuConsola" as UI
participant ":ControladorReservas" as CTRL
participant ":Agencia" as AGE
participant ":Reserva" as RES
participant ":GestorCancelaciones" as GC
participant ":RepositorioAgencia" as REPO

Vendedor -> UI : cancelar reserva
UI -> CTRL : cancelarReserva(id, motivo, fechaSalida, porAgencia)
CTRL -> AGE : buscarReserva(id)
alt reserva inexistente
  AGE --> CTRL : EntidadNoEncontradaException
  CTRL --> UI : informa error
else reserva encontrada
  AGE --> CTRL : reserva
  CTRL -> RES : puedeCancelarse()
  alt no cancelable
    RES --> CTRL : false
    CTRL --> UI : informa estado inválido
  else cancelable
    RES --> CTRL : true
    CTRL -> GC : crearCancelacion(motivo, fechaSalida, totalPagado, porAgencia)
    GC --> CTRL : cancelacion
    CTRL -> RES : registrarCancelacion(cancelacion)
    CTRL -> REPO : guardar(agencia)
    CTRL --> UI : importe devuelto
  end
end
@enduml
