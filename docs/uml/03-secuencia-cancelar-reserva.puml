@startuml 03-secuencia-cancelar-reserva
title CU15 - Cancelar reserva y gestionar devolución simulada

skinparam shadowing false
skinparam backgroundColor White
skinparam sequenceMessageAlign center
autonumber

actor Vendedor
participant ":MenuConsola" as UI
participant ":ControladorReservas" as CTRL
participant ":Agencia" as AGE
participant ":Reserva" as RES
participant ":Salida" as SAL
participant ":GestorCancelaciones" as GC
participant ":Cancelacion" as CAN
participant ":RepositorioAgencia" as REPO

Vendedor -> UI : cancelarReserva(idReserva, motivo, porAgencia)
UI -> CTRL : cancelarReserva(idReserva, motivo, porAgencia)
activate CTRL
CTRL -> AGE : buscarReserva(idReserva)
alt reserva inexistente
  AGE --> CTRL : EntidadNoEncontradaException
  CTRL --> UI : informa que la reserva no existe
  UI --> Vendedor : muestra error
else reserva encontrada
  AGE --> CTRL : reserva
  CTRL -> SAL : verificarVencimientos(hoy) / actualizarEstado(hoy)
  SAL --> CTRL : estado actualizado; si venció, la reserva pasa a ANULADA
  CTRL -> RES : puedeCancelarse()
  RES -> SAL : consulta estado de salida
  SAL --> RES : estado
  RES --> CTRL : puede / no puede
  alt reserva anulada/finalizada o salida en curso/finalizada
    CTRL --> UI : informa que no puede cancelarse
    UI --> Vendedor : muestra motivo
  else reserva cancelable
    CTRL -> GC : crearCancelacion(reserva, motivo, porAgencia, hoy)
    activate GC
    GC -> SAL : obtener fecha de inicio
    SAL --> GC : fechaSalida
    GC -> GC : calcularPorcentajeDevolucion(hoy, fechaSalida, porAgencia)
    GC -> RES : calcularTotalPagado()
    RES --> GC : capital abonado (sin recargos)
    GC -> RES : obtenerMedioPagoDevolucion()
    RES --> GC : medio del último pago (o ninguno)
    GC -> GC : importeDevuelto = capital × porcentaje
    create CAN
    GC -> CAN : <<create>> Cancelacion(fecha, motivo, porcentaje, importe, medio)
    GC --> CTRL : cancelación calculada
    deactivate GC

    CTRL -> RES : registrarCancelacion(cancelacion)
    RES -> RES : cambiarEstado(ANULADA)
    CTRL -> SAL : actualizarEstado(hoy)
    alt la salida queda cancelada por no alcanzar el cupo mínimo
      loop cada reserva vigente restante
        CTRL -> GC : cancelar(otraReserva, motivo, true, hoy)
        GC -> RES : puedeCancelarse() / calcularTotalPagado()
        RES --> GC : datos de la reserva
        create CAN
        GC -> CAN : <<create>> Cancelacion(..., 100 %, importe)
        GC -> RES : registrarCancelacion(cancelacion)
        GC --> CTRL : cancelación de agencia
      end
    end
    CTRL -> REPO : guardar(agencia)
    REPO --> CTRL : guardado
    CTRL --> UI : cancelación y devolución calculada
    UI --> Vendedor : muestra importe y medio de devolución
    note over UI,GC
    La devolución es simulada. El programa no ejecuta transferencias
    ni se conecta a Mercado Pago u otra pasarela externa.
    end note
  end
end
deactivate CTRL
@enduml
