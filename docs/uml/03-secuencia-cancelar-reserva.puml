@startuml 03-secuencia-cancelar-reserva
title CU15 - Cancelar reserva (devoluciones y flujos alternativos)

skinparam shadowing false
skinparam backgroundColor White
skinparam sequenceMessageAlign center
autonumber

actor Vendedor
participant ":MenuConsola" as UI
participant ":ControladorReservas" as CTRL
participant ":Agencia" as AGE
participant ":Reserva" as RES
participant ":GestorCancelaciones" as GC
participant ":Salida" as SAL
participant ":Cancelacion" as CAN
participant ":RepositorioAgencia" as REPO

Vendedor -> UI : cancelarReserva(numero, motivo, porAgencia)
UI -> CTRL : cancelarReserva(numero, motivo, porAgencia, ahora)
activate CTRL

CTRL -> AGE : buscarReserva(numero)

alt reserva inexistente
  AGE --> CTRL : EntidadNoEncontradaException
  CTRL --> UI : EntidadNoEncontradaException
  UI --> Vendedor : muestra error de busqueda

else reserva encontrada
  AGE --> CTRL : reserva
  CTRL -> RES : puedeCancelarse()
  RES --> CTRL : puede / no puede

  alt reserva no cancelable (estado ANULADA o FINALIZADA, o salida en curso o finalizada)
    CTRL --> UI : ReservaNoCancelableException
    UI --> Vendedor : informa que no puede cancelarse

  else reserva cancelable
    CTRL -> GC : cancelar(reserva, motivo, porAgencia, ahora)
    activate GC

    GC -> RES : getSalida()
    RES --> GC : salida
    GC -> SAL : diasHastaInicio(hoy)
    SAL --> GC : dias

    alt cancelacion por la agencia
      GC -> GC : porcentaje = 100
    else faltan 30 dias o mas
      GC -> GC : porcentaje = 90
    else faltan entre 15 y 29 dias
      GC -> GC : porcentaje = 50
    else faltan entre 7 y 14 dias
      GC -> GC : porcentaje = 20
    else faltan menos de 7 dias
      GC -> GC : porcentaje = 0
    end

    GC -> RES : totalAbonado()
    RES --> GC : abonado

    GC -> GC : importe = abonado * porcentaje / 100

    GC -> RES : medioDePagoUsado()
    RES --> GC : medio

    create CAN
    GC -> CAN : <<create>> new Cancelacion(fecha, motivo, porcentaje, importe, medio)

    GC -> RES : anular(cancelacion)
    GC --> CTRL : cancelacion
    deactivate GC

    note over RES,SAL
      Al anular la reserva sus pasajeros
      dejan de ocupar cupos: Salida cuenta
      solo las reservas que ocupan cupos.
    end note

    CTRL -> SAL : actualizarEstado(ahora)
    CTRL -> REPO : guardar(agencia)
    REPO --> CTRL : guardado

    CTRL --> UI : cancelacion
    UI --> Vendedor : muestra el importe a devolver

    note over UI
      El importe calculado no implica que el
      reintegro ya fue ejecutado: se acredita
      por el medio de pago original (S13).
    end note
  end
end

deactivate CTRL
@enduml
